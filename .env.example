# =============================================================================
# AI-Powered Criminal Network Analysis System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=cna_user
POSTGRES_PASSWORD=cna_secret_2026
POSTGRES_DB=criminal_network
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=criminal_network

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=cna_neo4j_2026
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_URI=bolt://localhost:7687

# --- Groq API (free tier, get key at https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key_here

# --- JWT Auth ---
JWT_SECRET_KEY=change_me_to_a_random_secret_string_2026
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Encryption (Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") ---
FERNET_KEY=change_me_generate_with_command_above
